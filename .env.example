# Canal
CANAL=telegram                 # telegram | whatsapp
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AssessorKM_bot   # usado no login do app web
# Bot API local (opcional): sobe o limite de arquivos de 20 MB para 2 GB. Veja docs/bot-api-local.md
TELEGRAM_API_BASE=             # ex.: http://telegram-api:8081 (vazio = https://api.telegram.org)
TELEGRAM_WEBHOOK_URL=          # ex.: http://assessor:3000/webhook/telegram quando usar o Bot API local
TELEGRAM_API_ID=               # my.telegram.org → API development tools
TELEGRAM_API_HASH=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# IA
GEMINI_API_KEY=
ANTHROPIC_API_KEY=             # opcional, fallback
MODELO_PADRAO=gemini-3.8-flash
MODELO_FALLBACK=                 # modelo reserva se o padrão der 503/429
MODELO_RAPIDO=gemini-3.1-flash-lite  # classificação e transcrição (baixa latência)

# Google (OAuth do dono — reaproveitar projeto do bot de agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assessor.kauemunchen.com.br/oauth/google/callback

# AgilFac (um token por empresa)
AGILFAC_API_URL=
AGILFAC_TOKENS=mais_textil:xxx,douglas:yyy

# Meta / Instagram (módulo Social)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Financeiro (v3)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
ASAAS_API_KEY=
FOCUS_NFE_TOKEN=

# Infra
PORT=3000
PUBLIC_URL=https://assessor.kauemunchen.com.br
DATABASE_URL=sqlite:./data/assessor.db
TZ=America/Sao_Paulo
FAL_API_KEY=
# Biblioteca da MIA: mídias apagam sozinhas após N dias (posts agendados/rascunho são preservados)
BIBLIOTECA_RETENCAO_DIAS=15

